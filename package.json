{
  "name": "dust-offering",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "A portrait browser game about guiding dust across the Black Pyramid.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "playwright test",
    "test:physics": "node scripts/physics-check.js",
    "playtest": "node scripts/playtest.js",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "deploy": "npm run build && node scripts/deploy.js --production",
    "deploy:branch": "npm run build && node scripts/deploy.js --branch",
    "deploy:branch:delete": "node scripts/deploy.js --delete-branch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
